# ── FRONTEND (Client-Safe — safe to expose in browser) ────────────────────────
# Your Supabase project URL (from: Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://zvlqhrsiojkptpnewqfm.supabase.co

# Supabase anon (public) key — safe for browser use
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp2bHFocnNpb2prcHRwbmV3cWZtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA1ODk3MzMsImV4cCI6MjEwNjE2NTczM30.S47bPUWNxRNAw8RsIoSFW5h2ft2hYvGyVl1GK4OsUP0

# Stripe publishable key — safe for browser use
STRIPE_PUBLISHABLE_KEY=pk_test_51PLACEHOLDER_REPLACE_WITH_YOUR_REAL_KEY

# ── SERVER-SIDE ONLY (Supabase Edge Functions Secrets) ────────────────────────
# Set these via CLI: supabase secrets set KEY=value
# NEVER put these in frontend code or commit to git.

# Supabase service role key (admin access — server only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_SERVICE_ROLE_KEY

# Supabase URL (same as above, used inside Edge Functions)
SUPABASE_URL=https://zvlqhrsiojkptpnewqfm.supabase.co

# Stripe secret key (server only)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# Stripe webhook signing secret (from: Stripe Dashboard > Webhooks > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET

# ── GOOGLE OAUTH (for Supabase Auth > Providers > Google) ────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ── HOW TO DEPLOY EDGE FUNCTIONS ──────────────────────────────────────────────
# 1. Install Supabase CLI: npm install -g supabase
# 2. Login: supabase login
# 3. Link project: supabase link --project-ref zvlqhrsiojkptpnewqfm
# 4. Set secrets:
#      supabase secrets set STRIPE_SECRET_KEY=sk_test_... SUPABASE_SERVICE_ROLE_KEY=... STRIPE_WEBHOOK_SECRET=whsec_...
# 5. Deploy functions:
#      supabase functions deploy verify-payment --project-ref zvlqhrsiojkptpnewqfm
#      supabase functions deploy stripe-webhook --project-ref zvlqhrsiojkptpnewqfm
# 6. Set Stripe webhook URL to:
#      https://zvlqhrsiojkptpnewqfm.supabase.co/functions/v1/stripe-webhook
#    Listen for: checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
